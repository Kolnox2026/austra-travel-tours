---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { primaryNav, serviceLinks } from '../data/nav';
import { site } from '../data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const isServicesActive = serviceLinks.some((link) => isActive(link.href));
const [home, ...restNav] = primaryNav;
---

<header class="sticky top-0 z-30 border-b border-navy-100 bg-cream/95 backdrop-blur">
  <div class="container-content flex h-20 items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/favicon.svg" alt="" class="h-9 w-9" />
      <span class="font-display text-lg font-bold leading-tight text-navy-800 sm:text-xl">
        AUSTRA <span class="text-gold-600">TRAVEL &amp; TOURS</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 xl:flex" aria-label="Primary">
      <a
        href={home.href}
        class:list={[
          'relative rounded-full px-3 py-2 text-sm font-medium transition-colors',
          isActive(home.href) ? 'text-navy-900 font-semibold' : 'text-navy-600 hover:text-navy-900',
        ]}
      >
        {home.label}
      </a>

      <div class="relative">
        <button
          id="services-dropdown-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="services-dropdown-panel"
          class:list={[
            'flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium transition-colors',
            isServicesActive ? 'text-navy-900 font-semibold' : 'text-navy-600 hover:text-navy-900',
          ]}
        >
          Services
          <Icon name="chevron-down" class="h-4 w-4 transition-transform" />
        </button>
        <div
          id="services-dropdown-panel"
          class="absolute left-0 top-full z-40 mt-2 hidden w-64 overflow-hidden rounded-2xl bg-white py-2 shadow-card-hover ring-1 ring-navy-100"
        >
          {
            serviceLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'block px-4 py-2.5 text-sm font-medium transition-colors',
                  isActive(link.href) ? 'bg-navy-50 text-navy-900' : 'text-navy-700 hover:bg-navy-50',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      {
        restNav.map((link) => (
          <a
            href={link.href}
            class:list={[
              'relative rounded-full px-3 py-2 text-sm font-medium transition-colors',
              isActive(link.href) ? 'text-navy-900 font-semibold' : 'text-navy-600 hover:text-navy-900',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex xl:flex">
      <WhatsAppButton
        message={`Hello ${site.name}, I'd like to enquire about your services.`}
        label="WhatsApp Us"
        variant="primary"
        class="!px-5 !py-2.5 text-xs"
      />
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full text-navy-700 xl:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-7 w-7" />
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-navy-100 bg-cream px-5 py-4 xl:hidden"
    aria-label="Mobile"
  >
    <a
      href={home.href}
      class:list={[
        'flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium',
        isActive(home.href) ? 'bg-navy-50 text-navy-900 font-semibold' : 'text-navy-700',
      ]}
    >
      {home.label}
    </a>

    <details class="mobile-services-details group" open={isServicesActive}>
      <summary
        class:list={[
          'flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-base font-medium',
          isServicesActive ? 'bg-navy-50 text-navy-900 font-semibold' : 'text-navy-700',
        ]}
      >
        Services
        <Icon name="chevron-down" class="mobile-services-icon h-4 w-4 transition-transform" />
      </summary>
      <div class="flex flex-col gap-1 py-1 pl-4">
        {
          serviceLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'rounded-lg px-3 py-2.5 text-sm font-medium',
                isActive(link.href) ? 'text-navy-900 font-semibold' : 'text-navy-600',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </details>

    {
      restNav.map((link) => (
        <a
          href={link.href}
          class:list={[
            'flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium',
            isActive(link.href) ? 'bg-navy-50 text-navy-900 font-semibold' : 'text-navy-700',
          ]}
        >
          <span>{link.label}</span>
        </a>
      ))
    }

    <div class="mt-2">
      <WhatsAppButton
        message={`Hello ${site.name}, I'd like to enquire about your services.`}
        label="WhatsApp Us"
        variant="primary"
        class="w-full"
      />
    </div>
  </nav>
</header>

<style>
  .mobile-services-details[open] .mobile-services-icon {
    transform: rotate(180deg);
  }
  .mobile-services-details summary::-webkit-details-marker {
    display: none;
  }
  #services-dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });

  const servicesToggle = document.getElementById('services-dropdown-toggle');
  const servicesPanel = document.getElementById('services-dropdown-panel');

  function closeServicesDropdown() {
    servicesPanel?.classList.add('hidden');
    servicesToggle?.setAttribute('aria-expanded', 'false');
  }

  servicesToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = servicesPanel?.classList.contains('hidden');
    servicesPanel?.classList.toggle('hidden');
    servicesToggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });

  document.addEventListener('click', (e) => {
    if (servicesPanel && !servicesPanel.classList.contains('hidden')) {
      if (!servicesPanel.contains(e.target as Node) && e.target !== servicesToggle) {
        closeServicesDropdown();
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeServicesDropdown();
  });
</script>
