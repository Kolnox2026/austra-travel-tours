---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';

export interface Props {
  message: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
}

const { message, label = 'Chat with us on WhatsApp', variant = 'primary', class: className = '' } =
  Astro.props;

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
}[variant];
---

<a
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer"
  class={`${variantClass} ${className}`}
>
  <Icon name="whatsapp" class="h-5 w-5" />
  <span>{label}</span>
</a>
