---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  light?: boolean;
}

const { eyebrow, title, subtitle, align = 'center', light = false } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : 'text-left']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2
    class:list={[
      'mt-2 text-3xl font-bold sm:text-4xl',
      light ? 'text-white' : 'text-navy-900',
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class:list={['mt-4 text-base leading-relaxed sm:text-lg', light ? 'text-navy-100' : 'text-navy-600']}>
        {subtitle}
      </p>
    )
  }
</div>
