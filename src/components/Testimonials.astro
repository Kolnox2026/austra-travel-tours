---
import Icon from './Icon.astro';
import { testimonials } from '../data/testimonials';
---

<section class="section bg-navy-50">
  <div class="container-content">
    <div class="max-w-2xl mx-auto text-center">
      <p class="eyebrow">Client stories</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl text-navy-900">What our clients say</h2>
    </div>

    {
      testimonials.length > 0 ? (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="card flex flex-col p-6">
              <Icon name="badge" class="h-6 w-6 text-gold-500" />
              <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-navy-700">"{t.quote}"</blockquote>
              <figcaption class="mt-4 border-t border-navy-100 pt-4">
                <p class="text-sm font-bold text-navy-900">{t.name}</p>
                {t.service && <p class="text-xs text-navy-500">{t.service}</p>}
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="mt-10 mx-auto max-w-xl rounded-2xl border-2 border-dashed border-navy-200 bg-white p-10 text-center">
          <p class="font-semibold text-navy-700">Client stories coming soon</p>
          <p class="mt-2 text-sm text-navy-500">
            We've helped real people travel, study, and relocate for years — their stories are on their way to this
            page.
          </p>
        </div>
      )
    }
  </div>
</section>
