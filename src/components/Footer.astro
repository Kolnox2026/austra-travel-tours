---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { footerServiceLinks, footerCompanyLinks } from '../data/nav';

const year = new Date().getFullYear();
---

<footer class="bg-navy-800 text-navy-100">
  <div class="container-content grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    <div>
      <span class="font-display text-xl font-bold text-white">
        AUSTRA <span class="text-gold-400">TRAVEL &amp; TOURS</span>
      </span>
      <p class="mt-3 text-sm leading-relaxed text-navy-200">{site.tagline}</p>
      <div class="mt-5 flex gap-3">
        {
          [
            { href: site.social.facebook, label: 'Facebook' },
            { href: site.social.instagram, label: 'Instagram' },
            { href: site.social.linkedin, label: 'LinkedIn' },
          ].map((s) => (
            <a
              href={s.href}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-navy-700 text-xs font-semibold text-navy-100 hover:bg-gold-500 hover:text-navy-900"
              aria-label={s.label}
            >
              {s.label[0]}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-wide text-gold-400">Services</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {
          footerServiceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-navy-200 hover:text-white">
                {link.label}
                {link.badge && <span class="ml-1 text-xs text-gold-400">({link.badge})</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-wide text-gold-400">Company</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {
          footerCompanyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-navy-200 hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-wide text-gold-400">Contact</h3>
      <ul class="mt-4 space-y-3 text-sm text-navy-200">
        <li class="flex items-start gap-2">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 flex-shrink-0 text-gold-400" />
          <span>{site.contact.address.line1}, {site.contact.address.line2}</span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="phone" class="h-4 w-4 flex-shrink-0 text-gold-400" />
          <a href={site.contact.phoneHref} class="hover:text-white">{site.contact.phoneDisplay}</a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mail" class="h-4 w-4 flex-shrink-0 text-gold-400" />
          <a href={`mailto:${site.contact.email}`} class="hover:text-white">{site.contact.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-700">
    <div class="container-content flex flex-col items-center justify-between gap-3 py-6 text-xs text-navy-300 sm:flex-row">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Registered in Accra, Ghana.</p>
    </div>
  </div>
</footer>
