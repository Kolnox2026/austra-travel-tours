---
import SectionHeading from './SectionHeading.astro';
import { faqItems } from '../data/faq';
---

<section class="section bg-navy-50">
  <div class="container-content max-w-3xl">
    <SectionHeading eyebrow="Questions" title="Frequently asked questions" />

    <div class="mt-10 divide-y divide-navy-200 rounded-2xl bg-white px-6 shadow-card sm:px-8">
      {
        faqItems.map((item) => (
          <details class="faq-item group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-900">
              {item.question}
              <span class="faq-icon flex h-6 w-6 flex-shrink-0 items-center justify-center text-xl font-light text-gold-500 transition-transform">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-navy-600 sm:text-base">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
</style>
