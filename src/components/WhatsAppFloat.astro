---
import Icon from './Icon.astro';
import { whatsappLink, defaultWhatsappMessage } from '../data/site';

const href = whatsappLink(defaultWhatsappMessage);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-card-hover transition-transform hover:scale-105 sm:h-16 sm:w-16"
>
  <Icon name="whatsapp" class="h-7 w-7 sm:h-8 sm:w-8" />
</a>
