---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-800">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.06]"
    style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"
  >
  </div>
  <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gold-500/20 blur-3xl"></div>

  <div class="container-content relative py-20 sm:py-24">
    {eyebrow && <p class="text-xs font-bold uppercase tracking-[0.25em] text-gold-400">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-base leading-relaxed text-navy-100 sm:text-lg">{subtitle}</p>}
  </div>
</section>
