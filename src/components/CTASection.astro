---
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../data/site';

export interface Props {
  title?: string;
  subtitle?: string;
  message: string;
}

const {
  title = 'Ready to start?',
  subtitle = "Send us a message on WhatsApp and we'll walk you through your options — no obligation.",
  message,
} = Astro.props;
---

<section class="section bg-gold-500">
  <div class="container-content flex flex-col items-center gap-6 text-center">
    <h2 class="max-w-2xl text-3xl font-bold text-navy-900 sm:text-4xl">{title}</h2>
    <p class="max-w-xl text-navy-800/80">{subtitle}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <WhatsAppButton {message} label="Chat on WhatsApp" variant="secondary" />
      <a href="/contact/" class="btn border-2 border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white">
        Contact Us
      </a>
    </div>
    <p class="text-xs text-navy-800/70">{site.contact.phoneDisplay} &middot; {site.contact.email}</p>
  </div>
</section>
