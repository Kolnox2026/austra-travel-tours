---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import VerificationBadge from './VerificationBadge.astro';
import { verificationSteps, sampleListings } from '../data/verification';

export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class="section relative overflow-hidden bg-navy-900 text-white">
  <div class="pointer-events-none absolute -left-32 top-1/3 h-96 w-96 rounded-full bg-gold-500/10 blur-3xl"></div>

  <div class="container-content relative">
    <SectionHeading
      eyebrow="What sets us apart"
      title="The Employer & Partner Verification Framework"
      subtitle="Every school, employer, and supplier we put in front of you has been checked against our framework first — and carries a public status so you can see exactly where that check stands. No other agency in this market publishes this."
      light
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        verificationSteps.map((step) => (
          <div class="relative rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <span class="font-display text-4xl font-bold text-gold-400/50">
              {String(step.step).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-base font-bold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-100">{step.description}</p>
          </div>
        ))
      }
    </div>

    {
      !compact && (
        <div class="mt-16">
          <h3 class="text-center font-display text-xl font-bold text-white sm:text-2xl">
            How a status looks, once published
          </h3>
          <p class="mx-auto mt-2 max-w-xl text-center text-sm text-navy-200">
            Illustrative examples — our live, named partner directory is published as verification checks are completed.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {sampleListings.map((item) => (
              <div class="rounded-2xl bg-white p-5 text-navy-900 shadow-card">
                <p class="text-xs font-bold uppercase tracking-wide text-navy-400">{item.category}</p>
                <p class="mt-1 text-base font-bold">{item.name}</p>
                <div class="mt-3">
                  <VerificationBadge status={item.status} size="sm" />
                </div>
                <p class="mt-3 text-xs leading-relaxed text-navy-500">{item.note}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="mt-14 flex flex-col items-center gap-4 rounded-2xl border border-gold-500/30 bg-gold-500/10 p-6 text-center sm:flex-row sm:text-left">
      <Icon name="document-check" class="h-10 w-10 flex-shrink-0 text-gold-400" />
      <p class="text-sm leading-relaxed text-navy-100">
        A <strong class="text-white">Rejected</strong> or <strong class="text-white">Under Review</strong> status is never hidden to close a sale. If we can't verify it, we tell you — even when a client is hoping we'll say yes.
      </p>
    </div>
  </div>
</section>
