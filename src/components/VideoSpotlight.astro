---
import Icon from './Icon.astro';

export interface Props {
  /**
   * YouTube video ID (the part after `v=` in a YouTube URL). Leave unset to
   * render a "video coming soon" placeholder instead — see PLACEHOLDERS.md.
   */
  youtubeId?: string;
  title?: string;
  subtitle?: string;
}

const {
  youtubeId,
  title = 'See how we work',
  subtitle = 'A short introduction to AUSTRA TRAVEL & TOURS, straight from the team.',
} = Astro.props;
---

<section class="section bg-cream">
  <div class="container-content">
    <div class="max-w-2xl mx-auto text-center">
      <p class="eyebrow">Meet us</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl text-navy-900">{title}</h2>
      <p class="mt-4 text-base leading-relaxed sm:text-lg text-navy-600">{subtitle}</p>
    </div>

    <div class="mt-10 mx-auto max-w-3xl">
      {
        youtubeId ? (
          <div class="video-embed relative overflow-hidden rounded-2xl bg-navy-900 shadow-card-hover" style="aspect-ratio: 16/9;">
            <img
              src={`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}
              alt=""
              class="absolute inset-0 h-full w-full object-cover opacity-70"
              loading="lazy"
            />
            <button
              type="button"
              class="play-trigger absolute inset-0 flex items-center justify-center"
              data-youtube-id={youtubeId}
              aria-label="Play video"
            >
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-gold-500 text-navy-900 shadow-card-hover transition-transform hover:scale-105 sm:h-20 sm:w-20">
                <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-7 w-7 sm:h-8 sm:w-8">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </button>
          </div>
        ) : (
          <div
            class="relative flex flex-col items-center justify-center gap-3 overflow-hidden rounded-2xl border-2 border-dashed border-navy-200 bg-white p-12 text-center"
            style="aspect-ratio: 16/9;"
          >
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-navy-800 text-gold-400">
              <Icon name="plane" class="h-7 w-7" />
            </span>
            <p class="font-semibold text-navy-700">Video coming soon</p>
            <p class="max-w-sm text-sm text-navy-500">
              This spot is reserved for a short introduction video — drop in a YouTube link and it goes live here.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

{
  youtubeId && (
    <script>
      document.querySelectorAll<HTMLButtonElement>('.play-trigger').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.youtubeId;
          const wrapper = btn.closest('.video-embed');
          if (!id || !wrapper) return;
          wrapper.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube.com/embed/${id}?autoplay=1" title="AUSTRA TRAVEL & TOURS video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        });
      });
    </script>
  )
}
