---
export interface Props {
  name: string;
  description: string;
  index: number;
}

const { name, description, index } = Astro.props;
---

<div class="card p-6">
  <span class="font-display text-2xl font-bold text-gold-500">{String(index).padStart(2, '0')}</span>
  <h3 class="mt-2 text-lg font-bold text-navy-900">{name}</h3>
  <p class="mt-2 text-sm leading-relaxed text-navy-600">{description}</p>
</div>
