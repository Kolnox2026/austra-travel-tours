---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PromiseCard from '../components/PromiseCard.astro';
import VerificationFramework from '../components/VerificationFramework.astro';
import CTASection from '../components/CTASection.astro';
import { ourPromise } from '../data/promise';
import { defaultWhatsappMessage } from '../data/site';
---

<BaseLayout
  title="Our Promise & Trust"
  description="AUSTRA TRAVEL & TOURS' published commitments and Employer & Partner Verification Framework — how we build trust with every client."
  path="/our-promise/"
>
  <PageHero
    eyebrow="Trust & Compliance"
    title="Our Promise"
    subtitle="Five commitments we hold ourselves to on every engagement, published so you always know exactly what to expect from us."
  />

  <section class="section">
    <div class="container-content">
      <SectionHeading eyebrow="Published Commitments" title="What we will always do" align="left" />
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {ourPromise.map((item) => <PromiseCard title={item.title} description={item.description} />)}
      </div>
    </div>
  </section>

  <VerificationFramework />

  <section class="section">
    <div class="container-content max-w-3xl">
      <SectionHeading eyebrow="Why this matters" title="Why we show our work" />
      <div class="mt-8 space-y-4 text-base leading-relaxed text-navy-600">
        <p>
          Too many people in this market have been burned by fake admission letters, fraudulent job offers, and
          agents who talk a big game. We built our verification framework so you don't have to take our word for
          it — you can see exactly where every opportunity stands before you commit a cedi.
        </p>
        <p>
          Every employer, school, or supplier we promote carries one of three public statuses —
          <strong class="text-navy-900">Verified</strong>, <strong class="text-navy-900">Under Review</strong>, or
          <strong class="text-navy-900">Rejected</strong> — and we keep checking even after a partner is approved.
          Trust, here, is something you can verify, not just something we ask for.
        </p>
      </div>
    </div>
  </section>

  <CTASection
    title="Have a partner or opportunity you want checked?"
    subtitle="Send us the details on WhatsApp and we'll run it through our verification framework."
    message={defaultWhatsappMessage}
  />
</BaseLayout>
