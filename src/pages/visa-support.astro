---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';

const service = services.find((s) => s.slug === 'visa-support')!;
---

<BaseLayout title={service.name} description={service.metaDescription} path="/visa-support/">
  <ServiceDetail service={service}>
    <p class="mt-8 flex items-start gap-2 text-sm leading-relaxed text-navy-500">
      <Icon name="shield" class="mt-0.5 h-4 w-4 flex-shrink-0 text-gold-500" />
      We prepare and submit every application to give you the strongest possible case. The final decision sits with
      the embassy or consulate, as it does with any application anywhere in the world.
    </p>
  </ServiceDetail>
</BaseLayout>
