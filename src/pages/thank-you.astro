---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { defaultWhatsappMessage } from '../data/site';
---

<BaseLayout
  title="Message Sent"
  description="Thank you for contacting AUSTRA TRAVEL & TOURS. We'll be in touch soon."
  path="/thank-you/"
>
  <section class="section">
    <div class="container-content flex flex-col items-center py-16 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-verified/10 text-verified">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-8 w-8">
          <circle cx="12" cy="12" r="9" />
          <path d="M8.5 12.5l2.3 2.3 4.7-5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <h1 class="mt-6 text-2xl font-bold text-navy-900">Thanks — your message is in</h1>
      <p class="mt-3 max-w-md text-navy-600">
        We've received it and will reply as soon as we can. If it's urgent, message us on WhatsApp instead.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">Back to Home</a>
        <WhatsAppButton message={defaultWhatsappMessage} label="WhatsApp Us" variant="outline" />
      </div>
    </div>
  </section>
</BaseLayout>
