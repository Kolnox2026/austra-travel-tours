---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import VerificationFramework from '../components/VerificationFramework.astro';
import VideoSpotlight from '../components/VideoSpotlight.astro';
import PromiseCard from '../components/PromiseCard.astro';
import TrustBar from '../components/TrustBar.astro';
import CTASection from '../components/CTASection.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { site, defaultWhatsappMessage } from '../data/site';
import { services } from '../data/services';
import { ourPromise } from '../data/promise';
---

<BaseLayout title={site.name} description={site.description} path="/">
  <section class="relative overflow-hidden bg-navy-800">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.06]"
      style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"
    >
    </div>
    <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-gold-500/20 blur-3xl"></div>

    <div class="container-content relative grid gap-12 py-20 sm:py-24 lg:grid-cols-2 lg:items-center lg:py-32">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-gold-400">Ghana &middot; International Mobility</p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-[3.25rem]">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-navy-100 sm:text-lg">
          {site.mission}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppButton message={defaultWhatsappMessage} label="Chat on WhatsApp" />
          <a href="/travel-tours/" class="btn-outline !border-white !text-white hover:!bg-white hover:!text-navy-900">
            Explore Services
          </a>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm sm:p-8">
        <p class="text-xs font-bold uppercase tracking-wide text-gold-400">Our Difference</p>
        <h2 class="mt-2 text-xl font-bold text-white sm:text-2xl">
          Verified before it ever reaches you
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-navy-100">
          Every school, employer, and travel supplier we recommend carries a public status —
          <strong class="text-white">Verified</strong>, <strong class="text-white">Under Review</strong>, or
          <strong class="text-white">Rejected</strong> — before you ever engage with it.
        </p>
        <a href="/our-promise/" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-gold-400 hover:text-gold-300">
          See how the framework works
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <section class="section">
    <div class="container-content">
      <SectionHeading
        eyebrow="What we do"
        title="Every service, backed by the same standard"
        subtitle="From a single flight ticket to a scholarship application, each service below is delivered against the same verification and disclosure standard."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <VideoSpotlight />

  <VerificationFramework />

  <section class="section bg-navy-50">
    <div class="container-content">
      <SectionHeading
        eyebrow="Our Promise"
        title="Commitments we publish, not just say"
        subtitle="These are the standards we hold ourselves to on every engagement — see the full list on our Trust & Compliance page."
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {ourPromise.slice(0, 4).map((item) => <PromiseCard title={item.title} description={item.description} />)}
      </div>
      <div class="mt-10 text-center">
        <a href="/our-promise/" class="btn-outline">
          Read Our Full Promise
        </a>
      </div>
    </div>
  </section>

  <CTASection message={defaultWhatsappMessage} />
</BaseLayout>
