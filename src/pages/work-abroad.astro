---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { comingSoonService } from '../data/services';
import { site } from '../data/site';

const service = comingSoonService;
const message = `Hello ${site.name}, please notify me when International Employment Mobility launches.`;
---

<BaseLayout title={service.name} description={service.metaDescription} path="/work-abroad/">
  <PageHero eyebrow="Coming Soon" title={service.name} subtitle={service.tagline} />

  <section class="section">
    <div class="container-content grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-review/10 px-4 py-1.5 text-sm font-bold text-review">
          <Icon name="clock" class="h-4 w-4" />
          Not yet live — pending licensing
        </div>

        <h2 class="mt-6 text-2xl font-bold text-navy-900">What we're building</h2>
        <p class="mt-4 text-base leading-relaxed text-navy-600">{service.summary}</p>

        <h3 class="mt-10 text-lg font-bold text-navy-900">What this service will commit to, from day one</h3>
        <ul class="mt-4 space-y-3">
          {
            service.features.map((feature) => (
              <li class="flex items-start gap-3">
                <Icon name="check-circle" class="mt-0.5 h-5 w-5 flex-shrink-0 text-verified" />
                <span class="text-sm leading-relaxed text-navy-700 sm:text-base">{feature}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex gap-3 rounded-xl border border-navy-200 bg-navy-50 p-5">
          <Icon name="badge" class="mt-0.5 h-5 w-5 flex-shrink-0 text-navy-700" />
          <p class="text-sm leading-relaxed text-navy-700">
            We are not currently placing candidates in jobs abroad, and we will not advertise, charge for, or
            facilitate any job placement until we hold the required licensing under Ghanaian law. Anyone contacting
            you claiming to offer this service on our behalf ahead of that is not acting for us.
          </p>
        </div>
      </div>

      <aside class="h-fit rounded-2xl bg-navy-800 p-7 text-white">
        <h3 class="text-lg font-bold">Want to be notified at launch?</h3>
        <p class="mt-2 text-sm leading-relaxed text-navy-100">
          Message us on WhatsApp and we'll reach out the moment this service is licensed and live.
        </p>
        <div class="mt-6">
          <WhatsAppButton {message} label="Notify Me at Launch" class="w-full" />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
