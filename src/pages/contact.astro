---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, defaultWhatsappMessage } from '../data/site';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with AUSTRA TRAVEL & TOURS in Kasoa, Ghana — WhatsApp, phone, email, or visit our office."
  path="/contact/"
>
  <PageHero
    eyebrow="Contact"
    title="Talk to us"
    subtitle="WhatsApp is the fastest way to reach us. You can also call, email, or visit our office in Kasoa."
  />

  <section class="section">
    <div class="container-content grid gap-10 lg:grid-cols-2">
      <div class="card p-8">
        <h2 class="text-xl font-bold text-navy-900">Reach us directly</h2>

        <ul class="mt-6 space-y-5">
          <li class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-navy-800 text-gold-400">
              <Icon name="map-pin" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wide text-navy-400">Office</p>
              <p class="mt-0.5 text-navy-800">{site.contact.address.line1}</p>
              <p class="text-navy-800">{site.contact.address.line2}</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-navy-800 text-gold-400">
              <Icon name="phone" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wide text-navy-400">Phone / WhatsApp</p>
              <a href={site.contact.phoneHref} class="mt-0.5 block text-navy-800 hover:text-gold-600">
                {site.contact.phoneDisplay}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-navy-800 text-gold-400">
              <Icon name="mail" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wide text-navy-400">Email</p>
              <a href={`mailto:${site.contact.email}`} class="mt-0.5 block text-navy-800 hover:text-gold-600">
                {site.contact.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-navy-800 text-gold-400">
              <Icon name="clock" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wide text-navy-400">Office Hours</p>
              {
                site.contact.hours.map((h) => (
                  <p class="mt-0.5 text-navy-800">
                    <span class="font-medium">{h.days}:</span> {h.time}
                  </p>
                ))
              }
            </div>
          </li>
        </ul>

        <div class="mt-8">
          <WhatsAppButton message={defaultWhatsappMessage} label="Start a WhatsApp Chat" class="w-full" />
        </div>
      </div>

      <div class="card flex flex-col justify-between p-8">
        <div>
          <h2 class="text-xl font-bold text-navy-900">Prefer email?</h2>
          <p class="mt-3 text-sm leading-relaxed text-navy-600">
            Send us a short message about what you're looking for — travel, study, visa support, or a business trip —
            and we'll reply with next steps.
          </p>
        </div>
        <a
          href={`mailto:${site.contact.email}?subject=${encodeURIComponent('Enquiry from website')}`}
          class="btn-secondary mt-6 w-full"
        >
          <Icon name="mail" class="h-5 w-5" />
          Email Us
        </a>
        <p class="mt-4 text-xs text-navy-400">
          Prefer a form? A booking/enquiry form is planned for a future update — WhatsApp and email remain the
          fastest ways to reach us in the meantime.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
